# PostgreSQL — PostGIS + pgvector (run via docker compose, see docker/)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=nearventure
DB_PASSWORD=nearventure_dev
DB_DATABASE=nearventure

# `npm run db:reset` is destructive and refuses to run unless this one-shot
# opt-in is supplied. Do not keep it enabled in a shared environment.
# ALLOW_DB_RESET=1

# SQL query logging (true/false)
DB_LOGGING=false

# Server
PORT=3000

# JWT
# DEV-ONLY default below. In production JWT_SECRET is REQUIRED — the app
# refuses to start with the dev default or with it unset (fail closed).
JWT_SECRET=dev-secret-change-me

# Default admin credentials (used only on empty DB).
# DEV-ONLY defaults below. In production ADMIN_LOGIN/ADMIN_PASSWORD are
# REQUIRED when seeding a fresh DB — the app fails startup (fail closed)
# rather than creating a well-known admin/admin account. Never logs the password.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# GraphHopper (self-hosted routing). Default points to the docker-compose service.
GRAPHHOPPER_URL=http://localhost:8981
# Telegram Bot
# Token from @BotFather. Powers the Telegram bot AND the admin analytics push
# (feedback notifications + daily digest). Leave empty to disable the bot.
TELEGRAM_BOT_TOKEN=

# Webhook secret token: REQUIRED when TELEGRAM_WEBHOOK_DOMAIN is set (prod).
# The webhook endpoint refuses unauthenticated updates (401) and fails closed
# (503) if this is unset in webhook mode. Generate: openssl rand -hex 16
# TELEGRAM_WEBHOOK_SECRET=

# Admin chat id for analytics push.
# How to get it:
#   1. Send any message to your bot in Telegram.
#   2. Open https://api.telegram.org/bot<TOKEN>/getUpdates → find "chat":{"id":<NUMBER>}.
#   3. Put that number here. Leave empty to disable TG push (events still land in DB).
ADMIN_TELEGRAM_CHAT_ID=

# Webhook (prod) vs polling (dev). Set TELEGRAM_WEBHOOK_DOMAIN to an https URL
# to switch to webhook mode. TELEGRAM_WEBHOOK_SECRET guards against spoofing.
TELEGRAM_WEBHOOK_DOMAIN=
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS origin of the app, with no path, credentials, query or hash.
# Required in production; public route links and Telegram Mini App buttons are
# not generated until it is configured. Mini App is served at <PUBLIC_URL>/tg/.
PUBLIC_URL=

# Optional: donation URLs for the "Помочь проекту" flow in the bot.
# Leave empty to hide the corresponding button. URLs are configured via env
# vars (not hardcoded) because the codebase is open source.
DONATE_BOOSTY_URL=
DONATE_CLOUDTIPS_URL=

# Advanced routing and POI-import options are documented in docs/environment.md
# and docs/data-refresh.md. Keep this starter file to values needed for normal
# local backend development.
