# Nearventure frontend (web SPA) — local dev environment.
# Copy to .env. In production the frontend is built into static assets and served
# by the backend/nginx, so this file is dev-only.

# API base URL. Dev: '/' (Vite proxies /api → http://localhost:3000).
# Prod: '/' (same-origin; nginx proxies /api → backend).
VITE_API_BASE_URL=/

# PMTiles basemap. Bare resource URL (the app prepends the `pmtiles://` scheme).
# Dev: Vite mounts VITE_PMTILES_DEV_DIR at /tiles/ and serves Range requests.
# Prod: nginx serves the same URL from its /var/tiles mount. Set
# VITE_PMTILES_VERSION to the Protomaps BUILD_DATE to cache-bust after each tile
# rebuild (nginx marks /tiles/ immutable).
VITE_PMTILES_URL=/tiles/pfo.pmtiles
# Development-only source directory, relative to apps/frontend.
VITE_PMTILES_DEV_DIR=../../docker/data/tiles
# VITE_PMTILES_VERSION=20260710

# Base URL used to build Mini App links (dev). Prod derives it server-side.
VITE_MINIAPP_BASE_URL=http://localhost:5173
