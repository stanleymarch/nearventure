{
  "distance_influence": 35,
  "priority": [
    {
      "if": "true",
      "multiply_by": "mtb_priority"
    },
    {
      "if": "road_class == PATH",
      "multiply_by": "1.4"
    },
    {
      "if": "road_class == FOOTWAY",
      "multiply_by": "1.2"
    },
    {
      "if": "road_class == BRIDLEWAY",
      "multiply_by": "1.2"
    },
    {
      "if": "road_class == TRACK",
      "multiply_by": "1.3"
    },
    {
      "if": "road_class == CYCLEWAY",
      "multiply_by": "1.1"
    },
    {
      "if": "road_class == LIVING_STREET",
      "multiply_by": "1.1"
    },
    {
      "if": "road_class == SERVICE",
      "multiply_by": "1.0"
    },
    {
      "if": "track_type == GRADE2",
      "multiply_by": "1.3"
    },
    {
      "if": "track_type == GRADE3",
      "multiply_by": "1.25"
    },
    {
      "if": "track_type == GRADE4",
      "multiply_by": "1.15"
    },
    {
      "if": "track_type == GRADE5",
      "multiply_by": "1.05"
    },
    {
      "if": "surface == GRAVEL",
      "multiply_by": "1.2"
    },
    {
      "if": "surface == FINE_GRAVEL",
      "multiply_by": "1.2"
    },
    {
      "if": "surface == DIRT",
      "multiply_by": "1.25"
    },
    {
      "if": "surface == GROUND",
      "multiply_by": "1.15"
    },
    {
      "if": "surface == COMPACTED",
      "multiply_by": "1.1"
    },
    {
      "if": "surface == WOOD",
      "multiply_by": "1.1"
    },
    {
      "if": "surface == ASPHALT",
      "multiply_by": "0.85"
    },
    {
      "if": "surface == CONCRETE",
      "multiply_by": "0.85"
    },
    {
      "if": "surface == PAVED",
      "multiply_by": "0.85"
    },
    {
      "if": "surface == PAVING_STONES",
      "multiply_by": "0.9"
    },
    {
      "if": "surface == COBBLESTONE",
      "multiply_by": "0.9"
    },
    {
      "if": "surface == SAND",
      "multiply_by": "0.85"
    },
    {
      "if": "mtb_rating > 3",
      "multiply_by": "0.15"
    },
    {
      "if": "hike_rating > 4",
      "multiply_by": "0"
    },
    {
      "if": "country == DEU && road_class == BRIDLEWAY && bike_road_access != YES",
      "multiply_by": "0"
    },
    {
      "if": "road_class == TRUNK",
      "multiply_by": "0.3"
    },
    {
      "if": "road_class == PRIMARY",
      "multiply_by": "0.4"
    },
    {
      "if": "road_class == SECONDARY",
      "multiply_by": "0.6"
    },
    {
      "if": "road_class == TERTIARY",
      "multiply_by": "0.9"
    },
    {
      "if": "road_class == RESIDENTIAL",
      "multiply_by": "1.0"
    },
    {
      "if": "road_class == MOTORWAY",
      "multiply_by": "0.0"
    },
    {
      "if": "bike_road_access == PRIVATE || bike_road_access == DESTINATION",
      "multiply_by": "0.1"
    },
    {
      "if": "!mtb_access && (!backward_mtb_access || roundabout)",
      "multiply_by": "0"
    },
    {
      "else_if": "!mtb_access && backward_mtb_access",
      "multiply_by": "0.2"
    }
  ],
  "speed": [
    {
      "if": "true",
      "limit_to": "mtb_average_speed"
    },
    {
      "if": "mtb_rating > 3",
      "limit_to": "5"
    },
    {
      "if": "mtb_rating > 2",
      "limit_to": "8"
    },
    {
      "if": "average_slope > 10",
      "limit_to": "9"
    },
    {
      "if": "average_slope < -12",
      "limit_to": "18"
    },
    {
      "if": "max_slope > 20",
      "limit_to": "8"
    },
    {
      "if": "max_slope > 12",
      "limit_to": "12"
    },
    {
      "if": "surface == SAND",
      "limit_to": "8"
    },
    {
      "if": "surface == DIRT",
      "limit_to": "6"
    },
    {
      "if": "!mtb_access && backward_mtb_access",
      "limit_to": "6"
    },
    {
      "if": "bike_road_access == PRIVATE || bike_road_access == DESTINATION",
      "limit_to": "6"
    }
  ]
}