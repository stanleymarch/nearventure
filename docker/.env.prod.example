# ─────────────────────────────────────────────────────────────────────────────
# Nearventure — production environment.
# Copy to .env.prod (gitignored) and fill in. Used by docker-compose.prod.yml:
#   cp docker/.env.prod.example docker/.env.prod && edit
#   docker compose --env-file docker/.env.prod -f docker/docker-compose.prod.yml up -d
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain / TLS ─────────────────────────────────────────────────────────────
# Public domain. nginx gets a Let's Encrypt cert for it; the Telegram webhook
# and the Mini App (/tg/) are served under it. Production compose explicitly
# passes PUBLIC_URL=https://$DOMAIN to the app.
DOMAIN=nearventure.ru
LETSENCRYPT_EMAIL=you@example.com

# ── Database ─────────────────────────────────────────────────────────────────
# CHANGE the password in production. Must match the `db` service credentials.
DB_PASSWORD=change-me-to-a-long-random-string

# ── App secrets ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# First admin (created once on an empty DB). REQUIRED in production — the
# app AND docker compose fail closed instead of creating a well-known
# admin/admin. Do NOT use the default value "admin" on a public host:
# set an explicit, non-obvious login here.
# ADMIN_LOGIN=
ADMIN_PASSWORD=change-me

# ── Telegram bot ────────────────────────────────────────────────────────────
# Token from @BotFather. Powers the bot, the webhook, the Mini App web_app
# button, and admin analytics push (feedback notifications + daily digest).
TELEGRAM_BOT_TOKEN=

# Webhook secret — a random string that guards /api/telegram/webhook against
# spoofed updates. Generate with: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=

# Admin chat id for analytics push. How to get it:
#   1. Send any message to your bot in Telegram.
#   2. Open https://api.telegram.org/bot<TOKEN>/getUpdates → find "chat":{"id":<NUMBER>}.
# Leave empty to disable TG push (events still land in the DB).
ADMIN_TELEGRAM_CHAT_ID=

# ── External support links (optional — leave empty to hide) ────────────────
# Boosty/CloudTips URLs are configured via env vars, not hardcoded. Nearventure
# does not accept Telegram Stars, cryptocurrency, or in-app payments.
DONATE_BOOSTY_URL=
DONATE_CLOUDTIPS_URL=

# Advanced routing limits, DB logging and the POI trusted-root import procedure
# use safe production defaults and are documented in docs/environment.md and
# docs/data-refresh.md. Do not add them here unless you intentionally need an
# override.
